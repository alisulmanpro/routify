# PostgreSQL connection used by Prisma
DATABASE_URL=postgresql://routify:routify_dev_pw@127.0.0.1:5433/routify?schema=public

NODE_ENV=development
PORT=4000
LOG_LEVEL=info


# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
FILE_SIGNING_SECRET=replace-with-64-hex-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated list of admin-web / other allowed origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
COOKIE_SAMESITE=strict
# COOKIE_SECURE defaults to true in production and false otherwise; set explicitly to override.
# COOKIE_SECURE=true

STORAGE_DIR=./uploads
SIGNED_URL_TTL_SECONDS=900

# nominatim (free, rate-limited) | google (needs GOOGLE_MAPS_API_KEY) | none (routes without map data)
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=routify-api (you@example.com)
# GOOGLE_MAPS_API_KEY=

# Road distances for route ordering:
#   google (default when GOOGLE_MAPS_API_KEY is set; enable "Routes API" for the key; falls back to osrm)
#   osrm (default otherwise; public demo server, light use only) | none (straight-line)
# ROUTING_PROVIDER=google
# Google travel mode for those distances: BICYCLE (default) | DRIVE | TWO_WHEELER (not available in Ireland)
# ROUTING_TRAVEL_MODE=BICYCLE
# OSRM_URL=https://router.project-osrm.org

# Used only by `python -m scripts.seed_admin` to create/update the first platform admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Platform Admin

# Only used by scripts/migrate_from_mongo.py (one-time data copy from the old MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/delivery_planner
