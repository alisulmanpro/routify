# PostgreSQL (Neon) connections used by Prisma, from the Neon console > Connection details. Use a dev branch, never production.
# DATABASE_URL is the app's connection: "Connection pooling" ON (the host ends in "-pooler"), plus pgbouncer=true.
# DIRECT_URL is the same database with pooling OFF; only `prisma migrate` / `prisma db push` use it.
# connect_timeout gives a suspended Neon compute time to wake up.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&pgbouncer=true&connect_timeout=15
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15
# Separate database used by pytest (it is wiped on every test run). Defaults to <dbname>_test on both hosts above.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb_test?sslmode=require&channel_binding=require&pgbouncer=true
# TEST_DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb_test?sslmode=require&channel_binding=require

NODE_ENV=development
PORT=4000
LOG_LEVEL=info


# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_ACCESS_SECRET=replace-with-64-hex-chars
JWT_REFRESH_SECRET=replace-with-64-hex-chars
FILE_SIGNING_SECRET=replace-with-64-hex-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated list of admin-web / other allowed origins
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=0
COOKIE_SAMESITE=strict
# COOKIE_SECURE defaults to true in production and false otherwise; set explicitly to override.
# COOKIE_SECURE=true

STORAGE_DIR=./uploads
SIGNED_URL_TTL_SECONDS=900

# nominatim (free, rate-limited) | google (needs GOOGLE_MAPS_API_KEY) | none (routes without map data)
GEOCODING_PROVIDER=nominatim
GEOCODING_USER_AGENT=routify-api (you@example.com)
# GOOGLE_MAPS_API_KEY=

# Road data and route optimisation (infra/routing has the OSRM + VROOM setup):
#   OSRM_URL: our own OSRM (road matrix of any size, route lines, navigation). Never the public demo server.
#   ROUTING_PROVIDER: osrm (default when OSRM_URL is set) | google (Routes API matrix, <= 60 points) | none (straight lines)
#   VROOM_URL: our VROOM; empty = the built-in planner only. If VROOM is down, the built-in planner takes over.
# OSRM_URL=http://127.0.0.1:5000
# VROOM_URL=http://127.0.0.1:3000
# ROUTING_PROVIDER=osrm
# Google travel mode when ROUTING_PROVIDER=google: BICYCLE (default) | DRIVE | TWO_WHEELER (not available in Ireland)
# ROUTING_TRAVEL_MODE=BICYCLE
# Route plans above this many stops run in the worker process (python -m app.worker), never in the API.
# PLANNER_INLINE_MAX=8

# ---- Email (password reset codes, security notices) ----
# EMAIL_PROVIDER picks how mail is sent:
#   console  - print emails to the log (development default; refused in production)
#   disabled - drop emails (production default until you configure one)
#   smtp     - ANY service with SMTP: Brevo, SendGrid, Mailgun, Amazon SES, Postmark, Zoho, Gmail/Workspace, your own server
#   brevo | sendgrid | resend | mailgun | postmark - that service's HTTP API (needs EMAIL_API_KEY)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=Routify
# EMAIL_REPLY_TO=support@yourdomain.com
# HTTP providers: the service's API key. sendgrid/mailgun accounts in the EU set EMAIL_API_REGION=eu.
# EMAIL_API_KEY=
# EMAIL_API_REGION=us
# MAILGUN_DOMAIN=mg.yourdomain.com
# SMTP (example: Brevo -> smtp-relay.brevo.com, port 587, starttls, your Brevo login + SMTP key)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls (port 587) | ssl (port 465) | none (local test servers only)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# How long an emailed reset code stays valid (5-60 minutes)
PASSWORD_RESET_TTL_MINUTES=15

# ---- In-app purchases (subscriptions) ----
# Comma-separated stores the app may buy through: mock (fake store for testing; refused in production), apple, google, revenuecat
PAYMENT_STORES=mock
# A test/demo server running NODE_ENV=production may keep the mock store only with this explicit opt-in:
# ALLOW_MOCK_STORE=true
# Apple (App Store Connect). APPLE_ENVIRONMENT=sandbox for TestFlight / sandbox testers; production also accepts
# sandbox receipts because App Review tests that way. APPLE_APP_ID is the numeric Apple ID of the app (production only).
# APPLE_BUNDLE_ID=com.azaan890.routify
# APPLE_ENVIRONMENT=sandbox
# APPLE_APP_ID=
# Google Play. The service account JSON needs "View financial data" + "Manage orders and subscriptions" in Play Console.
# GOOGLE_PACKAGE_NAME=com.azaan890.routify
# GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/play-service-account.json
# The Pub/Sub push subscription's audience (the webhook URL) and the service account it signs its push tokens as:
# GOOGLE_PUBSUB_AUDIENCE=https://api.yourdomain.com/api/v1/billing/webhooks/google
# GOOGLE_PUBSUB_SERVICE_ACCOUNT=pubsub-push@your-project.iam.gserviceaccount.com
# RevenueCat (PAYMENT_STORES=revenuecat). The SECRET key (sk_...) from RevenueCat > Project settings > API keys - never
# the app's public SDK key. REVENUECAT_WEBHOOK_AUTH = the Authorization header value you set on the RevenueCat webhook
# pointing at https://<your-api>/api/v1/billing/webhooks/revenuecat (e.g. "Bearer <long random string>").
# REVENUECAT_SECRET_API_KEY=sk_...
# REVENUECAT_WEBHOOK_AUTH=Bearer replace-with-a-long-random-string
# REVENUECAT_ENTITLEMENT=routify_pro

# Used only by `python -m scripts.seed_admin` to create/update the first platform admin.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Platform Admin

# Only used by scripts/migrate_from_mongo.py (one-time data copy from the old MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/delivery_planner

# Rider app versions the API supports (GET /config). Below MIN_APP_VERSION the app only shows "Update the app";
# below LATEST_APP_VERSION it suggests updating once per launch. Raise them after a store release.
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
