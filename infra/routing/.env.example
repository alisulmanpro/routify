# Routing proof of concept (Phase 6a). Copy to .env to change.
# OSRM speed profile: bicycle (riders, default) | car | foot. Changing it needs scripts/prepare-ireland.sh again.
OSRM_PROFILE=bicycle
# Geofabrik extract (Ireland and Northern Ireland).
OSM_EXTRACT_URL=https://download.geofabrik.de/europe/ireland-and-northern-ireland-latest.osm.pbf
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.4.0
VROOM_IMAGE=ghcr.io/vroom-project/vroom-docker:v1.14.0
# Largest table request OSRM accepts (points per side). 2,000-stop routes need 2,001.
OSRM_MAX_TABLE_SIZE=2500
